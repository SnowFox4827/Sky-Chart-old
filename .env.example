# Star Chart configuration
# Copy this file to .env (cp .env.example .env) and edit the values below.
# docker compose reads .env automatically; .env is git-ignored.

# Host port the app is served on -> open http://localhost:<PORT>
# Default: 5000
# Note: inside the container Flask always listens on 5000; this value only
# changes which port on your machine is mapped to it. When running locally
# with `python app.py`, PORT is read from the environment, e.g.
#   PORT=8080 python app.py

PORT=5000
